{
  "name": "notes",
  "version": "1.0.7",
  "private": true,
  "description": "Notion 式筆記網站：自有帳號、BlockNote 區塊編輯、SQLite 單容器部署",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "cli": "node dist/server/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint src tests scripts eslint.config.js vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:app": "node scripts/check-app.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/mantine": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hono/node-server": "2.1.6",
    "@mantine/core": "9.7.5",
    "@mantine/dates": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/pm": "3.33.0",
    "dayjs": "1.11.23",
    "fflate": "0.8.3",
    "frimousse": "0.4.0",
    "hono": "4.13.17",
    "lucide-react": "1.70.0",
    "markdown-it": "14.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "tar": "7.5.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
