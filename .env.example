# Copy to .env (never commit). All values optional.
# Host port the site is published on.
NOTES_PORT=8080
# Interface to publish on. 127.0.0.1 = this computer only (default). 0.0.0.0 = every interface, e.g. to reach
# the site from phones on the same LAN over plain HTTP; passwords then travel unencrypted on that network.
# For anything beyond a trusted home network use the HTTPS overlay instead (docs/DEPLOY.md).
NOTES_BIND=127.0.0.1
# Set to 1 only behind a trusted reverse proxy (the HTTPS overlay sets it): trusts X-Forwarded-Proto / X-Forwarded-For.
NOTES_TRUST_PROXY=0
# Upload size limit (MB).
NOTES_MAX_UPLOAD_MB=20
# HTTPS overlay (compose.https.yaml): trusted certificate and key for your real hostname.
# NOTES_TLS_CERT_FILE=/path/to/fullchain.pem
# NOTES_TLS_KEY_FILE=/path/to/privkey.pem
