# Copy to .env (never commit). All values optional.
# Host port the site is published on.
NOTES_PORT=8080
# Interface to publish on. 127.0.0.1 = this computer only (default). 0.0.0.0 = every interface, e.g. to reach
# the site from phones on the same LAN over plain HTTP; passwords then travel unencrypted on that network.
# For anything beyond a trusted home network use the HTTPS overlay instead (docs/DEPLOY.md).
NOTES_BIND=127.0.0.1
# Set to 1 only behind a trusted reverse proxy (the HTTPS overlay sets it): trusts X-Forwarded-Proto / X-Forwarded-Host /
# X-Forwarded-For, which makes cookies Secure and rate limits keyed by the real client address.
NOTES_TRUST_PROXY=0
# Only with NOTES_TRUST_PROXY=1: the header your proxy sets to the real client address, used for rate limiting.
# Leave empty to use the last X-Forwarded-For hop (correct for the HTTPS overlay). Behind Cloudflare set
# cf-connecting-ip. Never name a header that clients can reach the app with directly.
NOTES_CLIENT_IP_HEADER=
# Optional, 16+ characters: required (in the invite-code field) to create the first account, which becomes the
# administrator. Set it when the site is reachable by others before you have registered.
NOTES_SETUP_TOKEN=
# The public address users type, when the site sits behind a proxy or tunnel (e.g. https://notes.example.com).
# Writes are accepted only from this origin or from the host the request arrived on.
NOTES_PUBLIC_ORIGIN=
# Upload size limit (MB).
NOTES_MAX_UPLOAD_MB=90
# HTTPS overlay (compose.https.yaml): trusted certificate and key for your real hostname.
# NOTES_TLS_CERT_FILE=/path/to/fullchain.pem
# NOTES_TLS_KEY_FILE=/path/to/privkey.pem
